<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="out\**\*.cs" />
    <EmbeddedResource Remove="out\**" />
    <None Remove="out\**" />
    <Content Remove="out\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep large conversions inside a reusable managed-heap budget. Without
         a runtime limit the GC kept reserving commit after each large program
         and eventually exhausted the Windows page file. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="12884901888" />
  </ItemGroup>
</Project>
