<UserControl x:Class="XpaTaskExplorer.XpaTaskExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XpaTaskExplorer"
             MinWidth="320"
             MinHeight="240">
  <UserControl.Resources>
    <HierarchicalDataTemplate DataType="{x:Type local:XpaTaskNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding DisplayName}" />
        <TextBlock Text="  " />
        <TextBlock Foreground="#777777" Text="{Binding ClassName}" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="6">
      <TextBlock Text="Lê classes convertidas que herdam de UIControllerBase ou BusinessProcessBase." Foreground="#666666" TextWrapping="Wrap" />
      <DockPanel Margin="0,6,0,0">
        <Button DockPanel.Dock="Right" Width="80" Margin="6,0,0,0" Content="Atualizar" Click="RefreshButton_Click" />
        <TextBox x:Name="FilterTextBox" MinWidth="120" VerticalContentAlignment="Center" KeyDown="FilterTextBox_KeyDown" />
      </DockPanel>
      <TextBlock x:Name="StatusTextBlock" Margin="0,6,0,0" Foreground="#666666" />
    </StackPanel>
    <TreeView x:Name="TaskTree" Margin="6,0,6,6" MouseDoubleClick="TaskTree_MouseDoubleClick" />
  </DockPanel>
</UserControl>
